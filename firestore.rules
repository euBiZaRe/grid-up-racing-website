rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions & Security Guardrails
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isHardcodedAdmin() {
      return isAuthenticated() && (
        request.auth.uid in [
          'B0t4f4nqqpZIQKpT8Ed97xka5gM2',
          'uYUa2WYZ5TPg98vle6jQzzrItR53',
          '8nojtKUFKUUKDFFpnU6EdueLhkN2',
          '2TfuhZVILNQerQK95YL1304jYp83'
        ]
      );
    }

    function isDynamicAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/settings/admins) &&
        (request.auth.uid in get(/databases/$(database)/documents/settings/admins).data.uids);
    }

    function isAdmin() {
      return isHardcodedAdmin() || isDynamicAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // System Settings & Maintenance Mode
    // ===============================================================

    // Maintenance mode settings must be publicly readable by all clients
    match /settings/maintenance {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins registry is readable by authenticated users and writable strictly by hardcoded admins
    match /settings/admins {
      allow read: if isAuthenticated();
      allow write: if isHardcodedAdmin();
    }

    // Other general settings (excluding protected admins registry)
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && docId != 'admins';
    }

    // ===============================================================
    // User Profiles & Identity Management
    // ===============================================================

    match /users/{userId} {
      // Profiles are restricted to authenticated users to prevent scraping of PII
      allow read: if isAuthenticated();
      
      // Creating a profile: owner can create, but CANNOT elevate itself. Only hardcoded admins can set admin/role fields.
      allow create: if (
        isOwner(userId) &&
        !('isAdmin' in request.resource.data) &&
        !('role' in request.resource.data)
      ) || isHardcodedAdmin();

      // Updating a profile: owner or admin can update, but isAdmin and role can ONLY be modified by hardcoded admins
      allow update: if isHardcodedAdmin() || (
        (isOwner(userId) || isAdmin()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role'])
      );

      // Only admins can delete profiles
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Driver Claims
    // ===============================================================

    match /claims/{claimId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.discordId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Public Racing Content (Admin Managed)
    // ===============================================================

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /race_results/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /event_results/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /drivers/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /streams/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /m2rc_schedule/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /m2rc_results/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Race Lineups with team messaging & setups
    match /race_lineups/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      match /teams/{teamId}/messages/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
          (!('senderUid' in request.resource.data) || request.resource.data.senderUid == request.auth.uid)
        );
        allow update, delete: if isAdmin();
      }

      match /teams/{teamId}/setups/{setupId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (!('uploaderUid' in request.resource.data) || request.resource.data.uploaderUid == request.auth.uid);
        allow update: if isAuthenticated() && (resource.data.uploaderUid == request.auth.uid || resource.data.authorUid == request.auth.uid || isAdmin());
        allow delete: if isAuthenticated() && (resource.data.uploaderUid == request.auth.uid || isAdmin());
      }

      match /teams/{teamId}/checklist/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAdmin();
      }
    }

    // Leagues & Registrations
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if isAdmin();

      match /registrations/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Race Laps & Telemetry
    match /race_laps/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      match /laps/{lapId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    // ===============================================================
    // Availability & Attendance
    // ===============================================================

    match /event_availability/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /responses/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // ===============================================================
    // Applications & Registrations
    // ===============================================================

    match /applications/{appId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.discordUid == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /m2rc_registrations/{regId} {
      allow read: if true;
      allow create: if isAuthenticated() && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid || regId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /m2rc_stewarding/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Setups & Tools
    // ===============================================================

    match /setups/{setupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (!('uploaderUid' in request.resource.data) || request.resource.data.uploaderUid == request.auth.uid);
      allow update: if isAuthenticated() && (
        resource.data.uploaderUid == request.auth.uid ||
        resource.data.authorUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /setup_installations/{docId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /setup_jobs/{docId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Sync Requests & Admin Utilities
    // ===============================================================

    match /sync_requests/{docId} {
      allow read, write: if isAdmin();
    }

    match /suggestions/{docId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ===============================================================
    // Default Deny
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
