{
  "rules": {
    "setup_jobs": {
      "$machineId": {
        ".read": "auth != null",
        "$jobId": {
          ".write": "auth != null && (!data.exists() ? (newData.child('uid').val() === auth.uid || !newData.child('uid').exists()) : (data.child('uid').val() === auth.uid || !data.child('uid').exists()))"
        }
      }
    },
    "driver_registry": {
      "$machineId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "teams": {
      "$teamId": {
        "streams": {
          "$streamKey": {
            ".read": true,
            ".write": "auth != null"
          }
        },
        "drivers": {
          "$streamKey": {
            ".read": true,
            ".write": "auth != null"
          }
        }
      }
    },
    "telemetry": {
      ".read": true,
      ".write": "auth != null"
    },
    ".read": false,
    ".write": false
  }
}
